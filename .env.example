# Prototype mode: renders the prototype toolbar and starts the MSW mock backend.
NEXT_PUBLIC_PROTOTYPE=true
# Base latency (ms) added to every mocked API call.
NEXT_PUBLIC_MOCK_LATENCY_MS=400
# PoC backend (FastAPI) that proxies GetSales; /api/getsales/* is rewritten to it.
BACKEND_URL=http://localhost:8000
